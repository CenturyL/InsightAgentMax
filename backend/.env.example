# =========================
# InsightAgentPro 后端环境变量模板
# 不要把真实密钥提交到仓库
# =========================

# 项目基础配置
PROJECT_NAME=InsightAgentPro API
AGENT_NAME=InsightAgentPro
WORKSPACE_ROOT=/absolute/path/to/langchainPro

# 对话、路由、摘要模型（必填；内部路由和摘要固定使用 Flash）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_FLASH_INPUT_PRICE_MICROUSD_PER_MILLION=440000
DEEPSEEK_FLASH_OUTPUT_PRICE_MICROUSD_PER_MILLION=1320000
DEEPSEEK_PRO_INPUT_PRICE_MICROUSD_PER_MILLION=1320000
DEEPSEEK_PRO_OUTPUT_PRICE_MICROUSD_PER_MILLION=3960000

# MiniMax（可选）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.5

# Xiaomi MiMo（可选）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2-flash
MIMO_PRO_MODEL=mimo-v2-pro

# 检索 / PostgreSQL 知识库
KNOWLEDGE_INDEX_VERSION=qwen3_embedding_4b_v1
KNOWLEDGE_IMPORT_LEASE_SECONDS=300
BM25_MAX_CORPUS_CHUNKS=10000
RETRIEVAL_MODEL_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=20
RETRIEVAL_PROVIDER_MAX_RETRIES=2
LOCAL_EMBEDDING_MODEL=shibing624/text2vec-base-chinese
EMBEDDING_DEVICE=auto
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_TOP_N=3
RERANKER_MAX_DOCUMENTS=20
RERANKER_MAX_DOCUMENT_CHARS=8000
RERANKER_TIMEOUT_SECONDS=20
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=auto
BM25_CANDIDATE_K=30
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
RETRIEVAL_QUOTA_ENABLED=true
RETRIEVAL_RESERVATION_TIMEOUT_SECONDS=180
RETRIEVAL_DAILY_CALL_LIMIT=500
RETRIEVAL_DAILY_CALL_LIMIT_PER_IP=100
RETRIEVAL_DAILY_TOKEN_LIMIT=2000000
RETRIEVAL_DAILY_TOKEN_LIMIT_PER_IP=500000
RETRIEVAL_DAILY_COST_MICROUSD_LIMIT=100000
RETRIEVAL_DAILY_COST_MICROUSD_LIMIT_PER_IP=20000
EMBEDDING_PRICE_MICROUSD_PER_MILLION=20000
RERANKER_PRICE_MICROUSD_PER_MILLION=10000

# ReAct / PAE / 上下文压缩
REACT_MAX_TOOL_CALLS=8
REACT_MAX_NO_PROGRESS_CALLS=3
LOOP_GUARD_REPEAT_THRESHOLD=3
LOOP_GUARD_STAGNATION_THRESHOLD=4

# 执行沙盒：local（subprocess 兜底）/ e2b（需 E2B_API_KEY）/ disabled
SANDBOX_BACKEND=disabled
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_IDLE_MINUTES=5
E2B_API_KEY=
PAE_MAX_CALLS_PER_REQUEST=1
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_COMPRESSION_MAX_MESSAGES=14
CONTEXT_COMPRESSION_MAX_CHARS=12000
CONTEXT_COMPRESSION_RECENT_TURNS=4
CONTEXT_COMPRESSION_MIN_DELTA_MESSAGES=4

# MCP / Skill
MCP_ENABLED=false
MCP_CONFIG_PATH=
SKILL_COMPAT_MODE=claude

# PostgreSQL（必填：历史会话、长期记忆、checkpoint 都依赖）
# 本地开发宿主机端口使用 15432，容器内部仍使用 5432。
POSTGRES_URL=postgresql://username:password@127.0.0.1:5432/insightagent

LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_COLLECTION_NAME=agent_long_term_memory

# 请求预算与每日演示额度
USAGE_LIMIT_ENABLED=false
REQUEST_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS_PER_REQUEST=8
MAX_PAE_STEPS_PER_REQUEST=4
MAX_REFLECTION_CALLS_PER_REQUEST=1
MODEL_CALL_TIMEOUT_SECONDS=15
DAILY_MODEL_CALL_LIMIT=100
DAILY_MODEL_CALL_LIMIT_PER_IP=20
MODEL_DAILY_TOKEN_LIMIT=2000000
MODEL_DAILY_TOKEN_LIMIT_PER_IP=500000
MODEL_REQUEST_TOKEN_LIMIT=100000
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_DAILY_COST_MICROUSD_LIMIT=1000000
MODEL_DAILY_COST_MICROUSD_LIMIT_PER_IP=200000
MODEL_REQUEST_COST_MICROUSD_LIMIT=50000
MODEL_INPUT_PRICE_MICROUSD_PER_MILLION=0
MODEL_OUTPUT_PRICE_MICROUSD_PER_MILLION=0
MAX_QUERY_LENGTH=8000
MAX_UPLOAD_BYTES=10485760
MAX_AGENT_CONCURRENCY=4
